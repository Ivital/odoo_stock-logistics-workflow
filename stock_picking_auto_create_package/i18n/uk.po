#. module: stock_picking_auto_create_package
#: model_terms:ir.ui.view,arch_db:stock_picking_auto_create_package.view_picking_form
msgid "Auto Pack"
msgstr "Автопакування"

#. module: stock_picking_auto_create_package
#: model:ir.model.fields.selection,name:stock_picking_auto_create_package.selection__stock_picking_type__automatic_package_creation_mode__single
msgid "Single Package"
msgstr "Один пакунок"

#. module: stock_picking_auto_create_package
#: model:ir.model.fields,field_description:stock_picking_auto_create_package.field_stock_picking_type__auto_pack_requires_packaging
msgid "Auto Pack Requires Packaging"
msgstr "Автопакування потребує пакування"

#. module: stock_picking_auto_create_package
#: model:ir.model.fields,field_description:stock_picking_auto_create_package.field_stock_picking_type__automatic_package_creation_mode
msgid "Automatic Package Creation Mode"
msgstr "Режим автоматичного створення пакунків"

#. module: stock_picking_auto_create_package
#: model:ir.model.fields.selection,name:stock_picking_auto_create_package.selection__stock_picking_type__automatic_package_creation_mode__packaging
msgid "Per Smallest Packaging"
msgstr "На найменше пакування"

#. module: stock_picking_auto_create_package
#: model:ir.model.fields,help:stock_picking_auto_create_package.field_stock_picking_type__automatic_package_creation_mode
msgid ""
"Automatically create the delivery packages. Any lines not in a package will "
"automaticaly be packaged."
msgstr ""
"Автоматично створювати пакування доставки. Усі рядки без пакування буде "
"автоматично запаковано."

#. module: stock_picking_auto_create_package
#: model:ir.model.fields,help:stock_picking_auto_create_package.field_stock_picking_type__auto_pack_requires_packaging
msgid ""
"If enabled, automatic package creation will only apply to products that have"
" packaging defined."
msgstr ""
"Якщо ввімкнено, автоматичне створення пакувань застосовуватиметься лише до "
"товарів із визначеним пакуванням."
